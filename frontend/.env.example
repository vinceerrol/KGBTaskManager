# Used at build time. Leave empty for local development (Vite proxies /api to the backend).
# For a separate deployment, set the backend API address including /api.
VITE_API_URL=https://api.example.com/api

# The address teammates use to open the app. Used in links copied for Messenger.
# Running on one office PC: its Wi-Fi address, e.g. http://192.168.0.58:5173 (see docs/LOCAL_SETUP.md).
# Leave empty to use whatever address the browser is on.
VITE_PUBLIC_APP_URL=
